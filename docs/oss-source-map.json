        "lib": "src/lib.rs",
        "features": {
          "default": [],
          "test-support": []
        },
        "bins": [],
        "public_modules": [
          "test_support"
        ],
        "public_reexports": [
          "assurance::AuthenticationAssurance",
          "context::{AuthorizationReceipt, VerifiedContext}",
          "error::{AuthError, Result}",
          "evidence::UntrustedContext",
          "policy::{Activation, AuthChannel, CredentialSource, Policy, Route, SessionAuthority}",
          "production::{PinnedStatusTrust, ProductionVerifier}",
          "report::{AUTH_ROUTE_CHECK_SCHEMA, RouteCheck, RouteCheckReport}"
        ],
        "implicit_bins": []
      },
      "declared_commands": {}
    }
  ],
  "schema_definitions": [
